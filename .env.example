# Copy to .env and fill in values:  cp .env.example .env
#
# Cosmic AI uses RAG over data/training_data.json by default (no API key).
# Set ONE LLM provider below to generate answers from retrieved context.
# Today chatbot.py reads OpenAI + Ollama env vars; other providers need matching LangChain packages.

# -----------------------------------------------------------------------------
# Which LLM to use for RAG generation (planned / document your choice)
# Options: none | openai | ollama | anthropic | google | groq | mistral | azure | together
# "none" = retrieval-only (answers come straight from training_data.json)
# -----------------------------------------------------------------------------
LLM_PROVIDER=none

# -----------------------------------------------------------------------------
# OpenAI (https://platform.openai.com/api-keys)
# pip: langchain-openai  |  LangChain: ChatOpenAI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
# Optional: custom base URL (OpenAI-compatible proxies, e.g. some gateways)
# OPENAI_API_BASE=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Azure OpenAI (https://portal.azure.com)
# pip: langchain-openai  |  LangChain: AzureChatOpenAI
# -----------------------------------------------------------------------------
# AZURE_OPENAI_API_KEY=your-azure-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# AZURE_OPENAI_TEMPERATURE=0.3

# -----------------------------------------------------------------------------
# Anthropic Claude (https://console.anthropic.com/)
# pip: langchain-anthropic  |  LangChain: ChatAnthropic
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_TEMPERATURE=0.3

# -----------------------------------------------------------------------------
# Google Gemini (https://aistudio.google.com/apikey)
# pip: langchain-google-genai  |  LangChain: ChatGoogleGenerativeAI
# -----------------------------------------------------------------------------
# GOOGLE_API_KEY=your-google-ai-key-here
# GOOGLE_MODEL=gemini-2.0-flash
# GOOGLE_TEMPERATURE=0.3

# -----------------------------------------------------------------------------
# Groq (https://console.groq.com/) — fast inference, OpenAI-like API
# pip: langchain-groq  |  LangChain: ChatGroq
# -----------------------------------------------------------------------------
# GROQ_API_KEY=gsk_your-groq-key-here
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_TEMPERATURE=0.3

# -----------------------------------------------------------------------------
# Mistral AI (https://console.mistral.ai/)
# pip: langchain-mistralai  |  LangChain: ChatMistralAI
# -----------------------------------------------------------------------------
# MISTRAL_API_KEY=your-mistral-key-here
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_TEMPERATURE=0.3

# -----------------------------------------------------------------------------
# Together AI (https://api.together.xyz/)
# pip: langchain-together  |  LangChain: ChatTogether
# -----------------------------------------------------------------------------
# TOGETHER_API_KEY=your-together-key-here
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# TOGETHER_TEMPERATURE=0.3

# -----------------------------------------------------------------------------
# Ollama — local, no cloud API key (https://ollama.com)
# Run: ollama serve && ollama pull llama3.2
# pip: langchain-ollama  |  LangChain: ChatOllama
# -----------------------------------------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_TEMPERATURE=0.3

# -----------------------------------------------------------------------------
# Hugging Face Inference (https://huggingface.co/settings/tokens)
# pip: langchain-huggingface  |  for hosted inference endpoints
# -----------------------------------------------------------------------------
# HUGGINGFACE_API_KEY=hf_your-token-here
# HUGGINGFACE_ENDPOINT_URL=https://api-inference.huggingface.co/models/meta-llama/Llama-3.2-3B-Instruct

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=8080
DEBUG=false

# RAG retrieval (L2 distance; lower = closer match). Increase if too many "not found" replies.
RETRIEVAL_MAX_DISTANCE=1.15
