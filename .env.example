# Optional: enable LLM-generated answers (otherwise retrieval-only from training data)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3

# Server
PORT=8080
DEBUG=false

# RAG retrieval (L2 distance; lower = closer match). Increase if too many "not found" replies.
RETRIEVAL_MAX_DISTANCE=1.15
